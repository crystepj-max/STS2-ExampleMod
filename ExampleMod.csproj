<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>ExampleMod</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- macOS游戏路径 - 需要展开完整路径 -->
    <STS2GameDir>/Users/chris/Library/Application Support/Steam/steamapps/common/Slay the Spire 2</STS2GameDir>
    <STS2GameDataDir>$(STS2GameDir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</STS2GameDataDir>
    <ModsDir>$(STS2GameDir)/SlayTheSpire2.app/Contents/MacOS/mods</ModsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 游戏核心DLL -->
    <Reference Include="sts2">
      <HintPath>$(STS2GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Godot C#绑定 -->
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony补丁库 -->
    <Reference Include="0Harmony">
      <HintPath>$(STS2GameDataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BaseLib（已安装的mod） -->
    <Reference Include="BaseLib">
      <HintPath>$(ModsDir)/BaseLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
